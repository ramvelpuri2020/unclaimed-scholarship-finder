# ─────────────────────────────────────────────────────────────
# Unclaimed — frontend environment template
# Copy this file to .env.local, then restart `npm run dev`.
#
#   cp .env.example .env.local
#
# There are no secret keys in the frontend. The two API keys live in
# backend/.env (see backend/.env.example) and never reach the browser.
# ─────────────────────────────────────────────────────────────

# URL of the FastAPI backend. Local default:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
