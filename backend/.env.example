# ─────────────────────────────────────────────────────────────
# Unclaimed — backend environment template
# Copy this file to backend/.env, then fill in the two keys:
#
#   cp .env.example .env
#
# Never commit backend/.env. This template is safe to commit.
# ─────────────────────────────────────────────────────────────

# REQUIRED — TinyFish API key (search, page fetch, browser agent)
# Get one at https://tinyfish.ai/students
TINYFISH_API_KEY=

# REQUIRED — Google Gemini API key (resume reading, planning, extraction)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to try first. The backend probes which models your key can use
# and fails over inside a pool, so this does not have to be perfect.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: override the per-model rate-limit pool (JSON array).
# GEMINI_POOL_JSON=[{"name":"Gemini 3.1 Flash Lite","rpm":15,"tpm":250000,"rpd":500}]

# Where the Next.js dev server runs (comma-separate multiple origins).
CORS_ORIGINS=http://localhost:3000

# ── Hunt shape ────────────────────────────────────────────────
# Stop after this many committed results, or when the wall clock runs out.
STOP_AT_RESULTS=40

# Concurrent search queries and page fetches.
SEARCH_CONCURRENCY=4
FETCH_CONCURRENCY=12
FETCH_BATCH=3

# Concurrent Gemini extraction calls, and pages bundled per call.
EXTRACT_CONCURRENCY=12
EXTRACT_PAGES_PER_CALL=3

# Per-page fetch timeout, and how much page text is sent to Gemini.
PER_URL_TIMEOUT_MS=8000
MAX_PAGE_CHARS=9000

# Page budgets per round, and how many search rounds a hunt may run.
MAX_PAGES_ROUND_1=120
MAX_PAGES_LATER=50
MAX_ROUNDS=4

# Hard ceiling on Gemini requests for one hunt.
MAX_GEMINI_CALLS=600

# First-round query count (the planner enforces school/national quotas).
PLAN_QUERIES=16

# Resume characters kept for matching after the PDF is read.
RESUME_EXTRACT_CHARS=3500

# Whole-hunt wall clock, and timeout for the single optional browser agent.
WALL_TIMEOUT_SECONDS=180
LIST_AGENT_TIMEOUT_SECONDS=60

# Keep or disable the model-based page selector.
SELECTOR_ENABLED=true
